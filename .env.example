# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel: Project → Settings → Environment Variables (same names).

# ElevenLabs → Developers → API Keys. Needs Text to Speech + ElevenLabs Agents permissions.
ELEVENLABS_API_KEY=

# Voice used for "Read aloud". ElevenLabs → Voices → pick a voice → copy its Voice ID.
ELEVENLABS_VOICE_ID=

# The reading-companion agent. ElevenLabs → Agents → your agent → copy its Agent ID.
# Set the agent to private (authentication on) so only our signed URLs can start sessions.
# It is also the template copied for each uploaded document's own agent.
ELEVENLABS_AGENT_ID=

# Text-only Reed agent for /api/ai/* (explain, summarize, quiz). Private, and it must allow
# overrides of prompt, first_message and text_only (Agent → Security → Overrides).
ELEVENLABS_TEXT_AGENT_ID=

# Post-call webhook secret. ElevenLabs → Agents → Settings → Post-call webhook shows it when you add
# <deploy-url>/api/webhooks/elevenlabs. Transcripts are only saved when this is set.
ELEVENLABS_WEBHOOK_SECRET=

# Shared secret for agent server tools (e.g. save_note). Make one up: `openssl rand -hex 32`,
# and send it as the `x-agent-tool-secret` header in the tool config on ElevenLabs.
ELEVENLABS_TOOL_SECRET=

# Clerk auth. dashboard.clerk.com → your app → API Keys (Next.js). Every /api route except the
# ElevenLabs webhook and agent tools requires a signed-in user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional rolling-24h usage limits (defaults shown). Global caps protect the shared ElevenLabs quota.
# LIMIT_TTS_CHARS_PER_USER=5000
# LIMIT_TTS_CHARS_GLOBAL=20000
# LIMIT_UPLOADS_PER_USER=10
# LIMIT_UPLOADS_GLOBAL=100
# LIMIT_SESSIONS_PER_USER=30
# LIMIT_SESSIONS_GLOBAL=300
# LIMIT_AI_PER_USER=100
# LIMIT_AI_GLOBAL=1000

# Frontend (Vite, frontend/.env.local locally; Vercel env var in production): same value as
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY. Needed at build time.
VITE_CLERK_PUBLISHABLE_KEY=

# Neon Postgres. Vercel → Storage → Neon adds these automatically when deployed.
# Locally, `npx neon@latest claim create --file .env` makes a temporary database.
DATABASE_URL=
# Direct (unpooled) connection, used by `npm run db:migrate`. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Sitio público (sin barra final). Lo usan SEO, Stripe (URLs de vuelta) y correos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe → Developers → API keys / Webhooks. Productos: Reed Pro mensual y anual.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Clerk → Webhooks → endpoint <sitio>/api/webhooks/clerk, evento user.created.
CLERK_WEBHOOK_SIGNING_SECRET=

# Resend → API Keys. Sin clave, los correos se omiten sin error.
RESEND_API_KEY=

# PostHog → Project settings. Sin clave, no se manda analítica.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Pre-generated audio library (R-029..R-031). Vercel → Storage → Blob → create a public store.
# Read/write token: only the audio machine needs it (R-031). Not needed on Vercel.
BLOB_READ_WRITE_TOKEN=
# Public base URL of that store, e.g. https://<store-id>.public.blob.vercel-storage.com
# Set it on Vercel so /api/tts serves pre-generated audio before calling ElevenLabs (R-030).
REED_AUDIO_BASE_URL=

# Audio machine only (R-031): where VoiceStudio's backend listens.
VOICESTUDIO_URL=http://127.0.0.1:3900
# Only when VoiceStudio has an API key set (remote access, e.g. over Tailscale).
VOICESTUDIO_API_KEY=
